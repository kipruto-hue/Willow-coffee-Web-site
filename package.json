{
  "name": "willow-coffee",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Willow Coffee — immersive scroll site for a North Rift, Kenya single-origin coffee brand",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite-node scripts/prerender.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "render:harvest": "vite-node scripts/render-harvest-frames.ts",
    "render:stage": "vite-node scripts/render-stage.ts",
    "prerender": "vite-node scripts/prerender.ts",
    "check:bundle": "vite-node scripts/check-bundle.ts",
    "check:contrast": "vite-node scripts/check-stage-contrast.ts",
    "build:brand": "vite-node scripts/build-brand-art.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.1",
    "gsap": "^3.13.0",
    "lenis": "^1.3.11",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.185.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.8",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
